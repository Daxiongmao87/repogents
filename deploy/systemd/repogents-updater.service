[Unit]
Description=Update Repogents from origin/main
Wants=network-online.target
After=network-online.target
ConditionPathIsDirectory=%h/projects/repogents/.git

[Service]
Type=oneshot
WorkingDirectory=%h/projects/repogents
Environment=PYTHONUNBUFFERED=1
Environment=XDG_RUNTIME_DIR=%t
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=%t/bus
ExecStart=%h/projects/repogents/.venv/bin/python -m repogents.updater --repository %h/projects/repogents --state-file %h/.local/state/repogents/updater-restarted-commit --remote origin --branch main --service repogents.service
TimeoutStartSec=5min
UMask=0077
